# Server-side Graph (optional app-only automation)
CLIENT_ID=
TENANT_ID=
CLIENT_SECRET=
GRAPH_ORGANIZER_EMAIL=
GRAPH_CALENDAR_MAILBOX=nexusportal@scania.com

# Local SQLite database path (optional)
# NEXUS_LOCAL_DB_PATH=./db/nexus-local.sqlite

# Public canonical application URL used by deployment, smoke tests, and operations.
# NEXUS_APP_URL=https://portal.example.com

# Process at most this many queued jobs in one worker invocation.
# OUTBOX_BATCH_LIMIT=10

# Optional dangerous PoC admin tools (database inspector + local ticket wipe).
# Allowed automatically on localhost. For non-localhost hosts, set both:
#   NEXUS_ENABLE_LOCAL_TEST_TOOLS=true
#   NEXT_PUBLIC_NEXUS_ENABLE_LOCAL_TEST_TOOLS=true
# Prefer leaving these unset on shared PoC URLs.
# Optional AI integration
OPENAI_API_KEY=
OPENAI_MODEL=

# Cognito-hosted Entra login for the portal shell.
NEXT_PUBLIC_NEXUS_AUTH_MODE=cognito
NEXT_PUBLIC_NEXUS_APP_URL=https://portal.example.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_REGION=eu-north-1
NEXT_PUBLIC_COGNITO_IDP_NAME=EntraID

# Browser Entra ID login + delegated Graph meetings (SPA app registration)
NEXT_PUBLIC_MICROSOFT_GRAPH_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_GRAPH_TENANT_ID=
# Must match the SPA redirect URI in Entra (usually http://localhost:3000)
NEXT_PUBLIC_MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:3000

# Auth mode for the UI shell.
# - cognito: app uses Cognito-hosted sign-in with Entra federation before the portal loads
# - entra: app shows Entra sign-in and uses MSAL in the browser
# - external: app assumes authentication is handled upstream

# Optional test identity for external auth mode. This is only for local/dev testing when
# authentication is handled upstream and the UI still needs a user display name/email.
NEXT_PUBLIC_NEXUS_TEST_USER_NAME=
NEXT_PUBLIC_NEXUS_TEST_USER_EMAIL=

# Entra SPA setup notes:
# - Platform: Single-page application
# - Redirect URI: same as NEXT_PUBLIC_MICROSOFT_GRAPH_REDIRECT_URI
# - Login delegated permission: User.Read (enough to sign in)
# - Meeting permissions (requested when creating meetings): Calendars.ReadWrite, OnlineMeetings.ReadWrite
# - If meetings show "Need admin approval", grant admin consent for those meeting scopes
